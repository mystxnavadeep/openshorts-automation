# ==========================================
# OpenShorts Automation Environment Settings
# ==========================================

# ------------------------------------------
# GitHub API & Automation Settings
# ------------------------------------------
# Personal Access Token with 'repo' or 'workflow' scope
# Used by backend to trigger workflow_dispatch
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub repository owner and repository name
GITHUB_OWNER=mystxnavadeep
GITHUB_REPO=openshorts-automation
GITHUB_WORKFLOW_ID=openshorts.yml
GITHUB_BRANCH=main

# ------------------------------------------
# Server & Tailscale Network Binding
# ------------------------------------------
# Recommended: Set to your Tailscale IP (e.g. 100.85.12.34) or 127.0.0.1 behind Tailscale Serve/Nginx.
# Do NOT set to 0.0.0.0 on a public server without firewall.
HOST=0.0.0.0
PORT=8000

# CORS settings: comma-separated list of allowed origins (e.g. your Tailscale MagicDNS name)
# e.g. http://100.x.y.z:8000,http://openshorts-host.tailnet.ts.net:8000
ALLOWED_ORIGINS=*

# ------------------------------------------
# Google Drive & Processing Defaults
# ------------------------------------------
DEFAULT_GDRIVE_FOLDER=OpenShorts
DEFAULT_OUTPUT_FORMAT=vertical
DEFAULT_TARGET_CLIPS=3
DEFAULT_CLIP_MIN_SECONDS=15
DEFAULT_CLIP_MAX_SECONDS=60
