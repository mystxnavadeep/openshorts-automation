# Caddyfile for OpenShorts Dashboard via Tailscale MagicDNS
# Caddy natively integrates with Tailscale to obtain automatic TLS certs for .ts.net domains!

# Replace 'openshorts-server' and 'your-tailnet.ts.net' with your Tailscale MagicDNS domain:
# Example: openshorts.tailnet-xyz.ts.net

{
    # Optional global options
}

# Bind to Tailscale domain with automatic HTTPS
openshorts.your-tailnet.ts.net {
    reverse_proxy 127.0.0.1:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
}
